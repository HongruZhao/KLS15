theorem bootstrap248764_b_positive : ∀ j ≤ 200, 0 < bootstrap248764B j := by
  intro j hj
  interval_cases j <;> norm_num [bootstrap248764B, bootstrap248764BNat]

theorem bootstrap248764_a_initial : bootstrap248764A 0 = 1 := by
  norm_num [bootstrap248764A, bootstrap248764ANat]

theorem bootstrap248764_b_initial : bootstrap248764B 0 ≤
    ((59691/2500)^2 - (2221/100)*(59691/2500)-2)/((2221/100)*(59691/2500)) := by
  norm_num [bootstrap248764B, bootstrap248764BNat]

theorem bootstrap248764_a_step : ∀ j < 200,
    bootstrap248764A (j+1) ≤ bootstrap248764A j * (1+bootstrap248764B j) := by
  intro j hj
  interval_cases j <;> norm_num [bootstrap248764A, bootstrap248764ANat, bootstrap248764B, bootstrap248764BNat]

theorem bootstrap248764_b_step : ∀ j < 200,
    bootstrap248764B (j+1) ≤ bootstrap248764B j - bootstrap248764Epsilon/ bootstrap248764A (j+1) := by
  intro j hj
  interval_cases j <;> norm_num [bootstrap248764A, bootstrap248764ANat, bootstrap248764B, bootstrap248764BNat, bootstrap248764Epsilon]

theorem bootstrap248764_final_gap :
    2*bootstrap248764Epsilon/bootstrap248764A 200 < (bootstrap248764B 200)^2 := by
