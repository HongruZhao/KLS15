    detE.length=6445 ∧
    detO.length=6602 := by decide

theorem exponential_boundary_tables :
    alphaZeroTerms E11=[(0,0,6,(1020 : ℚ))] ∧
    alphaZeroTerms E12=[(0,0,6,(-1020 : ℚ))] ∧
    alphaZeroTerms E22=[(0,0,6,(1020 : ℚ))] ∧
    alphaZeroTerms O11=[(0,0,6,(828 : ℚ))] ∧
    alphaZeroTerms O12=[(0,0,6,(-828 : ℚ))] ∧
    alphaZeroTerms O22=[(0,0,6,(828 : ℚ))] ∧
    alphaZeroTerms detE=[] ∧
    alphaZeroTerms detO=[] := by
  refine ⟨?_,?_,?_,?_,?_,?_,?_,?_⟩ <;> rfl

theorem exponential_boundary_entries (L : ℝ) :
    evalTerms E11 0 L=(1020 : ℝ)*Real.exp (6*L) ∧
    evalTerms E12 0 L=(-1020 : ℝ)*Real.exp (6*L) ∧
    evalTerms E22 0 L=(1020 : ℝ)*Real.exp (6*L) ∧
    evalTerms O11 0 L=(828 : ℝ)*Real.exp (6*L) ∧
    evalTerms O12 0 L=(-828 : ℝ)*Real.exp (6*L) ∧
    evalTerms O22 0 L=(828 : ℝ)*Real.exp (6*L) ∧
    evalTerms detE 0 L=0 ∧
    evalTerms detO 0 L=0 := by
  rcases exponential_boundary_tables with ⟨h1,h2,h3,h4,h5,h6,h7,h8⟩
  rw [evalTerms_zero_alpha E11 L,evalTerms_zero_alpha E12 L,evalTerms_zero_alpha E22 L,evalTerms_zero_alpha O11 L,evalTerms_zero_alpha O12 L,evalTerms_zero_alpha O22 L,evalTerms_zero_alpha detE L,evalTerms_zero_alpha detO L,h1,h2,h3,h4,h5,h6,h7,h8]
  norm_num [evalTerms,termEval]

def normalizer (α L : ℝ) : ℝ :=
  (1+α)^2*(Real.exp L-1-L)+(1+α)*L+1

theorem normalizer_positive {α L : ℝ} (hα : 0≤α) (hL : 0≤L) : 0<normalizer α L := by
  have he:0≤Real.exp L-1-L := by linarith [Real.add_one_le_exp L]
  have h1:0≤1+α := by linarith
  have hp:=mul_nonneg (sq_nonneg (1+α)) he
  have hq:=mul_nonneg h1 hL
  unfold normalizer
  linarith

theorem clearing_denominators_positive {α L : ℝ} (hα : 0≤α) (hL : 0≤L) :
    0<(normalizer α L)^6 ∧ 0<(normalizer α L)^12 :=
  ⟨pow_pos (normalizer_positive hα hL) 6,pow_pos (normalizer_positive hα hL) 12⟩

theorem exponential_boundary_leading_positive (L : ℝ) :
    0<evalTerms E11 0 L ∧ 0<evalTerms O11 0 L := by
  rcases exponential_boundary_entries L with ⟨h1,h2,h3,h4,h5,h6,h7,h8⟩
  rw [h1,h4]
  exact ⟨mul_pos (by norm_num) (Real.exp_pos _),mul_pos (by norm_num) (Real.exp_pos _)⟩

