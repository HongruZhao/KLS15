import KLSConstantImprovement.ExponentialPolynomialSign
import KLSConstantImprovement.GammaRadialCurvatureCoefficients

/-! Frozen radial-hinge exact exponential-polynomial coefficient tables.
The actual-law block formula and finite derivative/allocation instantiation
are separate obligations; no universal curvature claim is made here.
The table lengths, exponential boundary, and positive clearing denominator
are verified directly. Every coefficient is retained as an exact rational.
-/
noncomputable section
open scoped BigOperators
namespace KLSConstantImprovement.RadialHingePolynomialData
set_option maxHeartbeats 10000000
set_option maxRecDepth 100000
set_option maxSynthPendingDepth 3
set_option backward.isDefEq.respectTransparency false

abbrev Term := ℕ×ℕ×ℕ×ℚ
def termEval (t : Term) (α L : ℝ) : ℝ :=
  (t.2.2.2:ℝ)*α^t.1*L^t.2.1*Real.exp ((t.2.2.1:ℝ)*L)
def evalTerms (ts : List Term) (α L : ℝ) : ℝ :=
  (ts.map fun t=>termEval t α L).sum
def alphaZeroTerms (ts : List Term) : List Term := ts.filter (fun t=>decide (t.1=0))

theorem evalTerms_zero_alpha (ts : List Term) (L : ℝ) :
    evalTerms ts 0 L=evalTerms (alphaZeroTerms ts) 0 L := by
  induction ts with
  | nil => rfl
  | cons t ts ih =>
    change termEval t 0 L+evalTerms ts 0 L=evalTerms (alphaZeroTerms (t::ts)) 0 L
    by_cases ht:t.1=0
    · have he:alphaZeroTerms (t::ts)=t::alphaZeroTerms ts := by simp [alphaZeroTerms,ht]
      rw [he]
      change termEval t 0 L+evalTerms ts 0 L=termEval t 0 L+evalTerms (alphaZeroTerms ts) 0 L
      exact congrArg (fun x=>termEval t 0 L+x) ih
    · have he:alphaZeroTerms (t::ts)=alphaZeroTerms ts := by simp [alphaZeroTerms,ht]
      rw [he]
      have hz:termEval t 0 L=0 := by unfold termEval;rw [zero_pow ht];ring
      rw [hz,zero_add]
      exact ih

