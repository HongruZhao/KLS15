import KLSConstantImprovement.LongPrefixCubicBellmanData
import KLSConstantImprovement.RawCubicWeightedBudget

/-! Exact scalar certificate for a conditional raw401.47 deduction. The old
all-rank weighted profile and every Bellman stage are reused unchanged.
Two independent nonnegative observation multipliers and exact rational Bellman stages are optimized. -/
noncomputable section
open scoped BigOperators
open Set
namespace KLSConstantImprovement.ResumeRaw40147BellmanData
open PositiveFiniteHeadBellman QuadraticCapBellmanCertificates WeightedOrbitBellmanTail
open KLSBelow25
set_option maxHeartbeats 0
set_option maxRecDepth 100000
set_option backward.isDefEq.respectTransparency false

def K : ℝ := 12453922967/976562500
def C : ℝ := 94537872950598081172577556748180064205479003/1738445318047622944125895864556700000000000000
def p : ℝ := 20927976127/20000000000
def originalC : ℝ := 5074295116709/100000000000000
abbrev tau := LongPrefixCubicBellmanData.tau
abbrev t := LongPrefixCubicBellmanData.t
abbrev ratioUpper := LongPrefixCubicBellmanData.ratioUpper
abbrev A := LongPrefixCubicBellmanData.A
abbrev chord := LongPrefixCubicBellmanData.chord
abbrev baseW := LongPrefixCubicBellmanData.baseW
def w (i : ℕ) : ℝ :=
  if i=0 then 12182647703/10000000000 else
  if i=1 then 571148440117/500000000000 else
  if i=2 then 1115409358379/1000000000000 else
  if i=3 then 64146216149/62500000000 else
  if i=4 then 964358305943/1000000000000 else
  if i=5 then 57526425713/62500000000 else
  tau
def line (i : ℕ) : Affine :=
  if i=0 then ⟨12182647703/10000000000,-⟩ else
  if i=1 then ⟨571148440117/500000000000,-⟩ else
  if i=2 then ⟨,-⟩ else
  if i=3 then ⟨,-255613101707514981890348171316444023/250000000000000000000000000000000000⟩ else
  if i=4 then ⟨964358305943/1000000000000,-⟩ else
  if i=5 then ⟨159847209388243895125529320152472425284831382383897373899184357638468647059239/172008651847820235322172957105377096358871329524714544350000000000000000000000,-398209719028547752983146868355408319373310338636864678721084421283824593009786252867408150427218037/428436499954055083513230886968192331907903944993133531599881017290000000000000000000000000000000000⟩ else
  ⟨tau,-tau⟩
def contact (i : ℕ) : ℝ :=
  if i=0 then  else
  if i=1 then  else
  if i=2 then 514840072081/500000000000 else
  if i=3 then 514840072081/500000000000 else
  if i=4 then 811376016328388510653273595338677591897019372122409588021934537617972485764256252867408150427218037/796289932884443466120547579311508911635581227917271486309615365664346626528189436656845200000000000 else
  if i=5 then 20840919762316532910851726455854342136518427/20698707688018957177932550346222300000000000 else
  0
def multiplier (i : ℕ) : ℝ :=
  if i=0 then 0 else
  if i=1 then 0 else
  if i=2 then  else
  if i=3 then  else
  if i=4 then 0 else
  if i=5 then 90780441660765764418831618375233047474695142330688431/10349353844009478588966275173111150000000000000000000000 else
  0
def domainTerm (i : ℕ) (r s : ℝ) : ℝ :=
  if i=0 then 0 else
  if i=1 then 0 else
  if i=2 then r-s else
  if i=3 then r-s else
  if i=4 then 0 else
  if i=5 then s-chord r else
  0
def dualWeight : ℝ := 2182647703/1773571229
def dualMultiplier : ℝ := 1773571229/10000000000
def dualHeight : ℝ := 632402707025130625974416732788085937500/30832565992790185055419634592278439591843

theorem t_positive (d : ℕ) (hd : 2 ≤ d) : 0<t d := LongPrefixCubicBellmanData.t_positive d hd
theorem t_floor (d : ℕ) (hd : 2 ≤ d) : tau ≤ t d := LongPrefixCubicBellmanData.t_floor d hd
theorem A_nonneg : 0 ≤ A := LongPrefixCubicBellmanData.A_nonneg
theorem ratioUpper_positive : 0<ratioUpper := LongPrefixCubicBellmanData.ratioUpper_positive
theorem p_positive : 0<p := by norm_num [p]
theorem p_interval : 1 ≤ p ∧ p ≤ ratioUpper := by
  norm_num [p,ratioUpper,LongPrefixCubicBellmanData.ratioUpper,LongPrefixCubicBellmanData.K]
theorem w_tail (i : ℕ) (hi : 6 ≤ i) : w i=tau := by
  simp only [w,show i≠0 by omega,show i≠1 by omega,show i≠2 by omega,
    show i≠3 by omega,show i≠4 by omega,show i≠5 by omega,ite_false]

theorem w_nonneg (i : ℕ) : 0 ≤ w i := by
  by_cases hi:i<6
  · interval_cases i <;> norm_num [w]
  · rw [w_tail i (by omega)];norm_num [tau,LongPrefixCubicBellmanData.tau]

theorem baseW_le_t (i : ℕ) : baseW i ≤ t (i+2) := LongPrefixCubicBellmanData.baseW_le_t i
theorem line_slope_nonneg (i : ℕ) (hi : i<7) : 0 ≤ (line i).slope := by
  interval_cases i <;> norm_num [line,tau,LongPrefixCubicBellmanData.tau]

theorem line_at_one (i : ℕ) (hi : i<7) : (line i).eval 1 ≤ 0 := by
  interval_cases i <;> norm_num [line,Affine.eval,tau,LongPrefixCubicBellmanData.tau]

theorem multiplier_nonneg (i : ℕ) (hi : i<6) : 0 ≤ multiplier i := by
  interval_cases i <;> norm_num [multiplier]
theorem square_identity (i : ℕ) (hi : i<6) (r s : ℝ) :
    w i*(r-s)+s*(line (i+1)).eval s-(line i).eval r=
      (line (i+1)).slope*(s-contact i)^2+multiplier i*domainTerm i r s := by
  interval_cases i <;>
    norm_num [w,line,Affine.eval,contact,multiplier,domainTerm,chord,LongPrefixCubicBellmanData.chord,capChord,A,ratioUpper,
      LongPrefixCubicBellmanData.A,LongPrefixCubicBellmanData.ratioUpper,LongPrefixCubicBellmanData.K,
      tau,LongPrefixCubicBellmanData.tau] <;> ring
theorem domainTerm_nonneg (i : ℕ) (r s : ℝ)
    (hs : 1 ≤ s) (hl : capChord A ratioUpper r ≤ s) (hr : s ≤ r) :
    0 ≤ domainTerm i r s := by
  unfold domainTerm
  split_ifs <;> (try dsimp only [chord,LongPrefixCubicBellmanData.chord]) <;> linarith

theorem stage_certificate (i : ℕ) (hi : i<6) :
    StageCertificate (w i) ratioUpper (capChord A ratioUpper) (line i) (line (i+1)) := by
  apply stage_certificate_of_square_identity (domainTerm i)
    (w_nonneg i)
    (line_slope_nonneg i (by omega)) (line_slope_nonneg (i+1) (by omega))
    (line_at_one i (by omega)) (line_at_one (i+1) (by omega))
    (multiplier_nonneg i hi) (square_identity i hi)
  intro r hr hrR s hs hl hsr
  exact domainTerm_nonneg i r s hs hl hsr

theorem terminal_line (r : ℝ) : (line 6).eval r=tau*(r-1) := by norm_num [line,Affine.eval] <;> ring

theorem strict_budget : C<p*(line 0).positive p := by
  have hh : C<p*(line 0).eval p := by
    norm_num [C,p,line,LongPrefixCubicBellmanData.line,Affine.eval]
  exact hh.trans_le (mul_le_mul_of_nonneg_left (le_max_right 0 ((line 0).eval p)) p_positive.le)

theorem augmentation_identity (c : ℕ → ℝ) (N : ℕ) :
    spend w c (N+2)=spend baseW c (N+2)+dualMultiplier*(dualWeight*c 0+c 1) := by
  induction N with
  | zero =>
    norm_num [spend,Finset.sum_range_succ,w,baseW,LongPrefixCubicBellmanData.baseW,t,LongPrefixCubicBellmanData.t,LongPrefixWeightedProfileData.t,
      dualMultiplier,dualWeight]
    ring
  | succ N ih =>
    have hw:w (N+2)=baseW (N+2) := by
      by_cases hi:N+2<6
      · have hn:N ≤ 3 := by omega
        interval_cases N <;> norm_num [w,baseW,LongPrefixCubicBellmanData.baseW,t,LongPrefixCubicBellmanData.t,LongPrefixWeightedProfileData.t]
      · rw [w_tail (N+2) (by omega)]
        simp [baseW,LongPrefixCubicBellmanData.baseW,hi]
    rw [show N+1+2=N+2+1 by omega,spend_succ w c (N+2),spend_succ baseW c (N+2),ih,hw]
    ring
theorem augmented_budget (c : ℕ→ℝ) (hc : ∀ i,0 ≤ c i)
    (hbudget : ∀ N,spend (fun i=>t (i+2)) c N ≤ originalC)
    (hdual : dualWeight*c 0+c 1 ≤ dualHeight) : ∀ N,spend w c N ≤ C := by
  intro N
  have hm : spend w c N ≤ spend w c (N+2) := by
    unfold spend
    rw [Finset.sum_range_add]
    exact le_add_of_nonneg_right (Finset.sum_nonneg fun i _ => mul_nonneg (w_nonneg _) (hc _))
  have hb : spend baseW c (N+2) ≤ originalC := by
    apply (Finset.sum_le_sum (fun i _ => mul_le_mul_of_nonneg_right (baseW_le_t i) (hc i))).trans
    exact hbudget (N+2)
  have hd := mul_le_mul_of_nonneg_left hdual
    (by norm_num [dualMultiplier,LongPrefixCubicBellmanData.dualMultiplier] : 0 ≤ dualMultiplier)
  calc
    spend w c N ≤ spend w c (N+2) := hm
    _ = spend baseW c (N+2)+dualMultiplier*(dualWeight*c 0+c 1) := augmentation_identity c N
    _  ≤  originalC+dualMultiplier*dualHeight := add_le_add hb hd
    _ = C := by norm_num [originalC,dualMultiplier,LongPrefixCubicBellmanData.dualMultiplier,dualHeight,C]

end KLSConstantImprovement.ResumeRaw40147BellmanData
