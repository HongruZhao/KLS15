theorem u_tail (i : ℕ) (hi : 47 ≤ i) : u i=u 47 := by
  have he : u 47=() := by norm_num [u]
  rw [he]
  unfold u
  repeat' rw [if_neg (by omega)]

theorem ratio_path_mem : r ∈ ratioPathSet A p := by
  refine ⟨by norm_num [r,p], ?_⟩
  intro i
  by_cases hi : i < 47
  · interval_cases i <;> norm_num [r,A,K,QuarticM48Profile20261020Data.K]
  · have h47 : 47 ≤ i := by omega
    rw [r_tail i h47, r_tail (i+1) (by omega)]
    norm_num [A,K,QuarticM48Profile20261020Data.K]

theorem eventually_one : ∀ i : ℕ,47 ≤ i → r i=1 := r_tail

theorem energy_step (i : ℕ) : u (i+1)=u i*r (i+1) := by
  by_cases hi : i < 47
  · interval_cases i <;> norm_num [u,r]
  · rw [u_tail (i+1) (by omega),u_tail i (by omega),r_tail (i+1) (by omega),mul_one]

theorem product_eq_energy (i : ℕ) : P r i=u i := by
  induction i with
  | zero => norm_num [u,P_zero]
  | succ i ih =>
    rw [P_succ,ih]
    exact (energy_step i).symm

