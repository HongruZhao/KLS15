theorem term_nonnegative (i : ℕ) : 0 ≤ w i*u i*(r i-r (i+1)) := by
  have hw : 0 ≤ w i :=
    (QuarticM48Profile20261020Data.t_positive (i+2) (by omega)).le
  have hu : 0 ≤ u i := by
    rw [←product_eq_energy i]
    exact P_nonnegative r (lower ratio_path_mem) i
  exact mul_nonneg (mul_nonneg hw hu)
    (sub_nonneg.mpr (successor_le ratio_path_mem i))

theorem term_zero (i : ℕ) (hi : 47 ≤ i) : w i*u i*(r i-r (i+1))=0 := by
  rw [r_tail i hi,r_tail (i+1) (by omega),sub_self,mul_zero]

theorem normalized_prefix_budget (N : ℕ) :
    p*(∑ i ∈ Finset.range N,w i*P r i*(r i-r (i+1))) ≤ C := by
  have hp : 0 ≤ p := by norm_num [p]
  have he :
      (∑ i ∈ Finset.range N ∩ Finset.range 47,w i*u i*(r i-r (i+1)))=
        (∑ i ∈ Finset.range N,w i*u i*(r i-r (i+1))) := by
    apply Finset.sum_subset Finset.inter_subset_left
    intro i hi hnot
    apply term_zero
    have hn : ¬ i < 47 := by
      intro hlt
      exact hnot (Finset.mem_inter.mpr ⟨hi,Finset.mem_range.mpr hlt⟩)
    omega
  have hle :
      (∑ i ∈ Finset.range N,w i*u i*(r i-r (i+1))) ≤
        (∑ i ∈ Finset.range 47,w i*u i*(r i-r (i+1))) := by
    rw [←he]
    apply Finset.sum_le_sum_of_subset_of_nonneg Finset.inter_subset_right
    intro i _ _
    exact term_nonnegative i
  simp_rw [product_eq_energy]
  calc
    _ ≤ p*(∑ i ∈ Finset.range 47,w i*u i*(r i-r (i+1))) :=
      mul_le_mul_of_nonneg_left hle hp
    _ = p*costLiteral := by rw [finite_spend_literal]
    _ ≤ C := literal_spend_budget

