import KLSConstantImprovement.RadialHingeInitialJetEntries

/-! Concrete derivative-order100 coefficients and dominant exponential budgets.
Every integer coefficient is bound to the original row by the Leibniz formula.
The sign and clearing-denominator checks are direct kernel arithmetic.
Actual-law block identification and the universal estimate are not asserted. -/
noncomputable section
namespace KLSConstantImprovement.RadialHingeDominantEntries
open RadialHingeInitialJetEntries
set_option maxHeartbeats 10000000
set_option maxRecDepth 100000
set_option backward.isDefEq.respectTransparency false

def derivativeCoefficient (ts : List JetTerm) (n b p : ℕ) : ℤ :=
  (ts.map fun t=> if t.2.1=p ∧ b ≤ t.1 ∧ t.1-b ≤ n then
    t.2.2*(n.choose (t.1-b):ℤ)*(t.1.descFactorial (t.1-b):ℤ)*
      (p:ℤ)^(n-(t.1-b)) else 0).sum
def coefficient (ts : List JetTerm) (b p : ℕ) : ℤ :=
  (ts.map fun t=>if t.1=b ∧ t.2.1=p then t.2.2 else 0).sum
def negativeBudget (ts : List JetTerm) (P Q : ℕ) : ℤ :=
  (ts.map fun t=>if t.2.1<P ∧ t.2.2<0 then
    (-t.2.2)*(t.1.factorial:ℤ)*(Q/(P-t.2.1)^t.1:ℕ) else 0).sum
def validRow (ts : List JetTerm) (B P Q : ℕ) : Bool :=
  ts.all fun t=>decide (t.1 ≤ B ∧ t.2.1 ≤ P ∧
    (t.2.1=P → 0 ≤ t.2.2) ∧
    (t.2.1<P ∧ t.2.2<0 → (P-t.2.1)^t.1 ∣ Q))
