import KLSConstantImprovement.RadialHingePolynomialData

/-! Exact integer-cleared initial-jet certificate for the frozen hinge tables.
All row bindings and all derivatives of order 0 through 99 are kernel checked.
Identification with analytic derivatives is a separate theorem obligation.
No actual-law or universal curvature assertion is made in this module. -/
noncomputable section
namespace KLSConstantImprovement.RadialHingeInitialJetEntries
open RadialHingePolynomialData
set_option maxHeartbeats 10000000
set_option maxRecDepth 100000
set_option backward.isDefEq.respectTransparency false

abbrev JetTerm := ℕ×ℕ×ℤ
def initialJet (ts : List JetTerm) (n : ℕ) : ℤ :=
  (ts.map fun t => if t.1 ≤ n then
    t.2.2 * (n.descFactorial t.1 : ℤ) * (t.2.1 : ℤ)^(n-t.1) else 0).sum
def originalRow (ts : List Term) (a : ℕ) (D : ℚ) : List (ℕ×ℕ×ℚ) :=
  ((ts.filter fun t=>decide (t.1=a)).map fun t=>(t.2.1,t.2.2.1,D*t.2.2.2))
def rationalRow (ts : List JetTerm) : List (ℕ×ℕ×ℚ) :=
  ts.map fun t=>(t.1,t.2.1,(t.2.2:ℚ))
